<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Aero.Core.Ai</PackageId>
    <Version>0.0.9.1-alpha</Version>
    <Authors>Microbians</Authors>
    <Title>AI services for the Aero Web Platform</Title>
    <Description>AI and LLM integration components for the Aero platform</Description>
    <PackageTags>aero;ai;llm</PackageTags>
    <PackageProjectUrl>https://github.com/microbian-systems/aero</PackageProjectUrl>
    <RepositoryUrl>https://github.com/microbian-systems/aero</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>aero-logo-new.png</PackageIcon>
