    <Compile Remove="IdentityManagementTests.cs" />
    <None Include="IdentityManagementTests.cs" />
    <Compile Remove="AeroIdentityModuleTests.cs" />
    <None Include="AeroIdentityModuleTests.cs" />
  </ItemGroup>
</Project>
